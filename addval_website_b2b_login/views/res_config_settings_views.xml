<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Port 19: ajustes con <setting> dentro del bloque "General" del sitio. -->
    <record id="res_config_settings_view_form_b2b_login" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.b2b.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='website_info_settings']" position="inside">
                <setting id="b2b_login_required_setting" string="B2B Login"
                         help="Redirect anonymous visitors to the login page on this website.">
                    <field name="b2b_login_required"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
