<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 16 settings use div.o_setting_box, not <setting id="..."> (Odoo 17+) -->
    <record id="res_config_settings_view_form_b2b_login" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.b2b.login</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='website_info_settings']" position="after">
                <h2>B2B Login</h2>
                <div class="row mt16 o_settings_container" id="b2b_login_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="b2b_login_required_setting">
                        <div class="o_setting_left_pane">
                            <field name="b2b_login_required"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="b2b_login_required"/>
                            <div class="text-muted">
                                Redirect anonymous visitors to the login page on this website.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
