<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_form_b2b_login" model="ir.ui.view">
        <field name="name">website.form.b2b.login</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='domain']" position="after">
                <group string="B2B Login" name="b2b_login_group">
                    <field name="b2b_login_required"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
