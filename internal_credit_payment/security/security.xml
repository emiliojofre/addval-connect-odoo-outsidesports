<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mismas reglas que en 16. -->
    <record id="partner_credit_manager_rule" model="ir.rule">
        <field name="name">Crédito: responsable de ventas ve todo</field>
        <field name="model_id" ref="model_partner_credit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>

    <record id="partner_credit_user_rule" model="ir.rule">
        <field name="name">Crédito: vendedor ve solo el suyo</field>
        <field name="model_id" ref="model_partner_credit"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
