<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_credit_payment_tree" model="ir.ui.view">
        <field name="name">partner.credit.list</field>
        <field name="model">partner.credit</field>
        <field name="arch" type="xml">
            <list string="Crédito de clientes" editable="bottom">
                <field name="partner_id"/>
                <field name="credit"/>
                <field name="update"/>
                <button name="do_update" type="object" string="Actualizar" class="btn btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_partner_credit_search" model="ir.ui.view">
        <field name="name">partner.credit.search</field>
        <field name="model">partner.credit</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
            </search>
        </field>
    </record>

    <record id="action_website_credit_payment" model="ir.actions.act_window">
        <field name="name">Crédito de clientes</field>
        <field name="res_model">partner.credit</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_website_credit_payment_tree"/>
    </record>

    <menuitem id="menu_website_credit_payment" name="Crédito" parent="sale.sale_menu_root"
              groups="sales_team.group_sale_salesman" sequence="45"/>
    <menuitem id="menu_website_credit_balance" action="action_website_credit_payment"
              parent="menu_website_credit_payment"/>
</odoo>
