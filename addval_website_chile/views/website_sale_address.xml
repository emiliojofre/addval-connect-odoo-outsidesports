<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Port 19: en 16 se reemplazaba el formulario completo de dirección del
        B2C. En 19 se ajustan solo los campos del formulario estándar
        (portal.address_form_fields), en una vista específica del sitio B2C:
        teléfono con prefijo +56 y RUT obligatorio. La comuna la añade
        addval_website_address.
    -->
    <template id="address_chile_rut_phone"
              inherit_id="portal.address_form_fields"
              name="Chile B2C - Teléfono +56 y RUT obligatorio">
        <xpath expr="//div[@id='div_phone']" position="replace">
            <div id="div_phone" class="col-lg-6 mb-2">
                <label class="col-form-label" for="o_phone">Teléfono (9 dígitos)</label>
                <div class="input-group">
                    <span class="input-group-text">+56</span>
                    <input id="o_phone" type="tel" name="phone" class="form-control"
                           inputmode="tel" maxlength="9" placeholder="912345678"
                           title="Ingresa 9 dígitos. Se agregará +56 automáticamente."
                           t-att-value="(partner_sudo.phone or '').replace('+56', '').replace(' ', '')"/>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@id='div_vat']/label" position="replace">
            <label class="col-form-label fw-bold" for="o_vat">RUT</label>
        </xpath>
        <xpath expr="//input[@id='o_vat']" position="attributes">
            <attribute name="placeholder">12345678-9</attribute>
        </xpath>
        <xpath expr="//input[@name='required_fields']" position="attributes">
            <attribute name="t-att-value">'name,email,phone' + (',vat' if is_used_as_billing else '')</attribute>
        </xpath>
    </template>

    <record id="address_chile_rut_phone" model="ir.ui.view">
        <field name="website_id" search="[('id','=',3)]" model="website"/>
    </record>
</odoo>
