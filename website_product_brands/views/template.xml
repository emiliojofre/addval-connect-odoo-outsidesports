  <!--
      Port a Odoo 19 (Outside Sports):
      - Filtro de marca dentro del formulario estándar de filtros
        (website_sale.product_attribute_filters_form): sirve en escritorio y en
        el panel móvil, y el JS estándar envía el formulario al marcar.
      - Se quitan: la página propia de productos por marca (redirige a /shop
        filtrado), los "chips" de marcas seleccionadas (jQuery) y la herencia de
        website_sale.products_description (no existe en 19).
  -->
    <data>

    <template id="inherited_website_sale_cart_website_product_brands_wk" name="website product brand" inherit_id="website_sale.product" active="True">
      <xpath expr="//div[@id='o_wsale_product_details_content']" position="inside">
                <t t-if="product.product_brand_id">
                    <div class="mb-4">
                        <b>Marca : <span t-field="product.product_brand_id" class="text-muted"/></b>
                    </div>
                </t>
      </xpath>
    </template>
    <template id="disable_product_default_codes" inherit_id="eq_website_default_code.product_default_codes" active="False"/>

    <template id="products_attributes" inherit_id="website_base_filter_attribute.inherit_website_products" priority="100" name="Product Brand's Filters" active="True" customize_show="True">
        <xpath expr="//div[hasclass('wk_product_custom_filters')]" position="inside">
            <div t-if="brand_rec" class="products_brands_filter accordion-item nav-item mb-1 order-3" t-att-data-brand_set="brand_set">
                <strong class="o_products_attributes_title d-block my-2">Marca</strong>
                <div class="flex-column">
                    <t t-foreach="brand_rec" t-as="b">
                        <div class="form-check mb-1">
                            <input type="checkbox" name="attrib_brand" class="form-check-input"
                                   t-attf-id="wk_brand_{{b.id}}{{'_mobile' if isMobile else ''}}"
                                   t-att-value="'%s-%s' % (b.id, b.id)"
                                   t-att-checked="'checked' if b.id in (brand_set or []) else None"
                                   t-att-data-brand="b.id"/>
                            <label class="form-check-label fw-normal" t-attf-for="wk_brand_{{b.id}}{{'_mobile' if isMobile else ''}}" t-field="b.name"/>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <!-- El contenedor estándar de filtros solo existe si hay atributos o etiquetas;
         con marcas publicadas también debe mostrarse. -->
    <template id="wk_horizontal_brands" name="Brand filter container" inherit_id="website_sale.products_attributes" active="True">
        <xpath expr="//div[@id='wsale_products_attributes_collapse']" position="attributes">
            <attribute name="t-if">attributes or all_tags or brand_rec</attribute>
        </xpath>
    </template>

    <template id="inherited_products_description_website_product_brands" inherit_id="website_sale.products_item" active="True">
      <xpath expr="//div[hasclass('oe_subdescription_wrapper')]/div[hasclass('oe_subdescription')]" position="inside">
            <b t-if="product.product_brand_id">Marca:<span t-field="product.product_brand_id" class="text-muted"/></b>
      </xpath>
    </template>

    <template id="wk_header_brand" inherit_id="website.template_header_default" name="Header Shop Brands Link">
        <xpath expr="//t[@t-foreach='website.menu_id.child_id']" position="after">
                <li class="nav-item oe_sale_brands">
                    <a href="/shop/brands" class="nav-link">
                        Marca
                    </a>
                </li>
        </xpath>
    </template>

    <template id="wk_brands_page" name="Brands Page">
      <t t-call="website.layout">
            <t t-set="additional_title">Marcas</t>
            <div id="wrap" class="js_sale">
                <div class="oe_structure" id="oe_structure_website_sale_products_1"/>
                <div class="container oe_website_sale py-3">
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                        <form t-att-action="keep('/shop/brands', search=0)" method="get">
                            <t t-call="website.website_search_box"/>
                        </form>
                        <t t-call="website.pager"/>
                    </div>
                    <div t-if="wk_brands_list" class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
                        <div t-foreach="wk_brands_list" t-as="wk_brand" class="col">
                            <t t-call="website_product_brands.wk_brands_item"/>
                        </div>
                    </div>
                    <div t-else="" class="text-center text-muted">
                        <t t-if="not search">
                            <h3 class="mt8">Marca no definida</h3>
                        </t>
                        <t t-else="">
                            <h3 class="mt8">No results</h3>
                            <p>No results for "<strong t-out="search"/>".</p>
                        </t>
                    </div>
                    <div class="d-flex justify-content-center mt-3">
                        <t t-call="website.pager"/>
                    </div>
                </div>
                <div class="oe_structure mb32" id="oe_structure_website_sale_products_2"/>
            </div>
        </t>
    </template>

      <template id="wk_brands_item" name="brands  card">
          <t t-set="brand_href" t-value="'/shop?attrib_brand=%s-%s' % (wk_brand.id, wk_brand.id)"/>
          <div class="card h-100 oe_product_cart">
              <div class="card-body p-1 oe_product_image">
                  <a t-att-href="brand_href">
                      <span class="d-flex h-100 justify-content-center align-items-center">
                          <img t-attf-src="/web/image/wk.product.brand/#{wk_brand.id}/image" class="img img-fluid" t-att-alt="wk_brand.name"/>
                      </span>
                  </a>
              </div>
              <div class="card-body p-0 text-center o_wsale_product_information">
                  <div class="p-2 o_wsale_product_information_text">
                      <h6 class="o_wsale_products_item_title">
                          <a t-att-href="brand_href" t-field="wk_brand.name"/>
                      </h6>
                      <div class="product_price">
                           <span t-out="wk_brand.total_products"/> Products
                      </div>
                      <div class="brand_description"/>
                  </div>
                  <div class="o_wsale_product_btn"/>
              </div>
          </div>
      </template>

        <template id="brand_shop_now" inherit_id="website_product_brands.wk_brands_item" active="False" customize_show="True" name="Shop Now Button">
            <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="after">
                <a t-att-href="brand_href" class="btn btn-success mb-2" title="View Brand Products">
                    <span>Shop Now</span>
                </a>
            </xpath>
        </template>

        <template id="brand_description" inherit_id="website_product_brands.wk_brands_item" active="False" customize_show="True" name="Brand Description">
            <xpath expr="//div[hasclass('brand_description')]" position="inside">
                <span t-if="wk_brand.description" class="small text-muted" t-out="wk_brand.description"/>
            </xpath>
        </template>

    </data>
</odoo>
