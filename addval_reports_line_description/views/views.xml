<?xml version="1.0" encoding="utf-8"?>
<!--
    Port a Odoo 19 (Outside Sports): mismos cambios que en 16 sobre las
    plantillas nuevas de 19 (xpaths por nombre de celda, no por posición):
    - Factura, presupuesto y albarán: columna SKU y descripción = nombre del
      producto (+ variantes en presupuesto y albarán).
    - Presupuesto: cantidad sin unidad y sin columna de impuestos.
    - Compra y solicitud de presupuesto: descripción = nombre del producto.
    - Albarán: "STOCK A MANO" (cantidad disponible) en lugar de "Entregado".
    - Guía de despacho (l10n_cl_edi_stock): títulos SKU/DESCRIPCIÓN, sin UdM.
-->
<odoo>
    <template id="report_invoice_with_payments_inherit" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_sku" class="text-start"><strong>SKU</strong></th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            <td name="td_sku">
                <span t-field="line.product_id.default_code" t-options="{'widget': 'text'}"/>
            </td>
            <td name="account_invoice_line_name">
                <span t-field="line.product_id.name" t-options="{'widget': 'text'}"/>
            </td>
        </xpath>
        <!-- Secciones y notas ocupan una columna más (la de SKU). -->
        <xpath expr="(//t[@t-set='line_colspan'])[1]" position="attributes">
            <attribute name="t-value">4 + (1 if display_discount else 0) + (1 if display_taxes and not line.tax_ids else 0)</attribute>
        </xpath>
    </template>

    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//td[@id='product']/span[@t-field='line.name']" position="replace">
            <span t-field="line.product_id.name"/>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_inherit"
              inherit_id="purchase.report_purchasequotation_document" priority="30">
        <xpath expr="//td[@id='product']/span[@t-field='order_line.name']" position="replace">
            <span t-field="order_line.product_id.name"/>
        </xpath>
    </template>

    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document" priority="55">
        <!-- Sin columna de impuestos (en 16 se borraban th/td a mano). -->
        <xpath expr="//t[@t-set='display_taxes']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_default_code" class="text-start">
                <t t-set="colspan_count" t-value="colspan_count + 1"/>
                <span>SKU</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_product_name']" position="replace">
            <td name="td_default_code">
                <span t-field="line.product_id.default_code"/>
            </td>
            <td name="td_product_name" t-att-class="padding_class">
                <span t-field="line.product_id.name"/>
                <span t-out="', '.join(line.product_id.product_template_variant_value_ids.mapped('name'))"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']" position="replace">
            <td name="td_product_quantity" class="o_td_quantity text-end">
                <span t-field="line.product_uom_qty"/>
            </td>
        </xpath>
    </template>

    <template id="report_delivery_document_inherit" inherit_id="stock.report_delivery_document" priority="30">
        <xpath expr="//th[@name='th_sm_product']" position="before">
            <th name="th_sm_sku"><strong>SKU</strong></th>
        </xpath>
        <xpath expr="//th[@name='th_sml_product']" position="before">
            <th name="th_sml_sku"><strong>SKU</strong></th>
        </xpath>
        <xpath expr="//th[@name='th_sm_quantity']" position="replace">
            <th name="th_sm_quantity" class="text-end"><strong>STOCK A MANO</strong></th>
        </xpath>
        <xpath expr="//th[@name='th_sml_quantity']" position="replace">
            <th name="th_sml_quantity" class="text-end"><strong>STOCK A MANO</strong></th>
        </xpath>
        <!-- Primero la celda de entregado (td[3]); luego se parte td[1] en SKU + nombre. -->
        <xpath expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[3]" position="replace">
            <td class="o_td_quantity text-end">
                <span t-field="move.product_id.qty_available"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr[@t-foreach='lines']/td[1]" position="replace">
            <td>
                <span t-field="move.product_id.default_code"/>
            </td>
            <td>
                <span t-field="move.product_id.name"/>
                <span t-out="', '.join(move.product_id.product_template_variant_value_ids.mapped('name'))"/>
            </td>
        </xpath>
    </template>

    <template id="stock_report_delivery_aggregated_move_lines_inherit"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines" priority="30">
        <xpath expr="//tr[@t-foreach='aggregated_lines']/td[1]" position="replace">
            <td>
                <span t-out="aggregated_lines[line]['product'].default_code"/>
            </td>
            <td>
                <span t-out="aggregated_lines[line]['product'].name"/>
                <span t-out="', '.join(aggregated_lines[line]['product'].product_template_variant_value_ids.mapped('name'))"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="replace">
            <td class="text-end" name="move_line_aggregated_quantity">
                <span t-out="format_number(aggregated_lines[line]['product'].qty_available)"/>
            </td>
        </xpath>
    </template>

    <template id="delivery_guide_document_inherit"
              inherit_id="l10n_cl_edi_stock.delivery_guide_document" priority="30">
        <xpath expr="//th[@name='th_code']" position="replace">
            <th name="th_sku"><strong>SKU</strong></th>
        </xpath>
        <xpath expr="//th[@name='th_product']" position="replace">
            <th name="th_product"><strong>DESCRIPCIÓN</strong></th>
        </xpath>
        <xpath expr="//th[@groups='uom.group_uom']" position="replace"/>
        <xpath expr="//td[@groups='uom.group_uom']" position="replace"/>
    </template>
</odoo>
