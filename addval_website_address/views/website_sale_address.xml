<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Port 19: en 16 este módulo reemplazaba el formulario completo de
        website_sale.address. En 19 el formulario es portal.address_form_fields
        (compartido por el checkout y por Mi cuenta); solo se cambia el bloque
        de ciudad: si el país es Chile se elige la comuna (city_id) y el campo
        de texto "city" queda oculto y se rellena con su nombre.
        El JS (static/src/js/website_sale.js) filtra las comunas por región y
        alterna selector/texto al cambiar de país.
    -->
    <template id="address_form_fields_cl_communes"
              inherit_id="portal.address_form_fields"
              name="Chile - Comuna en el formulario de dirección">
        <xpath expr="//div[@id='div_city']" position="replace">
            <t t-set="cl_country" t-value="request.env.ref('base.cl', raise_if_not_found=False)"/>
            <t t-set="cl_current_country" t-value="country or partner_sudo.country_id"/>
            <t t-set="cl_is_chile" t-value="bool(cl_country) and cl_current_country == cl_country"/>
            <t t-set="cl_cities" t-value="cl_country and request.env['res.city'].sudo().search([('country_id', '=', cl_country.id), ('code', '!=', False)], order='name')"/>
            <div id="div_city" class="col-md-8 mb-2 o_cl_city_wrapper"
                 t-att-data-cl-country-id="cl_country.id if cl_country else ''">
                <label class="col-form-label" for="o_city">
                    <span class="o_cl_city_label_comuna" t-att-style="None if cl_is_chile else 'display: none'">Comuna</span>
                    <span class="o_cl_city_label_city" t-att-style="'display: none' if cl_is_chile else None">City</span>
                </label>
                <select id="o_city_id" name="city_id"
                        class="form-select o_cl_city_select"
                        t-att-disabled="None if cl_is_chile else 'disabled'"
                        t-att-style="None if cl_is_chile else 'display: none'">
                    <option value="">Comuna...</option>
                    <option t-foreach="cl_cities" t-as="c"
                            t-att-value="c.id"
                            t-att-data-state-id="c.state_id.id"
                            t-att-data-zip="c.zipcode or ''"
                            t-att-selected="c.id == partner_sudo.city_id.id"
                            t-out="c.name"/>
                </select>
                <input id="o_city" type="text" name="city"
                       class="form-control o_cl_city_input"
                       t-att-value="partner_sudo.city"
                       t-att-style="'display: none' if cl_is_chile else None"/>
            </div>
        </xpath>
    </template>
</odoo>
