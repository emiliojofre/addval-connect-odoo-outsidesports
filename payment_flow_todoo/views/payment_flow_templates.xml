<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Port 19: Flow genera una URL por pago; el formulario de redirección
         lleva al cliente a esa URL con el token (GET). -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="get">
            <input type="hidden" name="token" t-att-value="flow_token"/>
        </form>
    </template>
</odoo>
