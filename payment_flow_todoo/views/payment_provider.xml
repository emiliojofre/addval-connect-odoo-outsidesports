<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_flow_provider_form" model="ir.ui.view">
        <field name="name">payment.flow.provider.form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'flow'">
                    <field name="flow_api_key" required="code == 'flow' and state != 'disabled'"/>
                    <field name="flow_private_key" password="True" required="code == 'flow' and state != 'disabled'"/>
                    <field name="flow_payment_method"/>
                    <a colspan="2" href="https://www.flow.cl/docs/api.html" target="_blank">
                        How to configure your Flow account?
                    </a>
                </group>
            </group>
        </field>
    </record>
</odoo>
