<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="transaction_form_flow" model="ir.ui.view">
        <field name="name">transaction.form.flow</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_flow_fetch_status" type="object"
                        string="Consultar estado en Flow"
                        invisible="provider_code != 'flow' or state not in ('draft', 'pending', 'error')"/>
            </xpath>
            <xpath expr="//field[@name='provider_reference']" position="after">
                <field name="flow_token" invisible="provider_code != 'flow'"/>
                <field name="fees" invisible="provider_code != 'flow'"/>
            </xpath>
        </field>
    </record>
</odoo>
