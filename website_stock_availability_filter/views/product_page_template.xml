<!--
    Port a Odoo 19 (Outside Sports): el formulario de filtros ahora es
    website_sale.product_attribute_filters_form (se usa en la barra lateral y en
    el panel móvil), así que el filtro de stock se inserta ahí una sola vez.
-->
<odoo>
	<template id="avalible_in_stock" name="Availability Filter">
		<div class="accordion-item nav-item mb-1 in_stock_filter order-0">
			<div><strong class="o_products_attributes_title d-block my-2">Stock</strong></div>
			<div class="flex-column">
				<div class="form-check mb-1">
					<input type="checkbox" class="form-check-input" t-attf-id="stock_filter{{'_mobile' if isMobile else ''}}"
						   name="show_instock" value="on" t-att-checked="'checked' if show_instock else None"/>
					<label class="form-check-label fw-normal" t-attf-for="stock_filter{{'_mobile' if isMobile else ''}}">En Stock</label>
				</div>
			</div>
		</div>
	</template>

	<template id="avalible_in_stock_attribute" name="Availability Filter Attribute"
			  inherit_id="website_sale.product_attribute_filters_form" priority="9">
		<xpath expr="//form[contains(@t-attf-class, 'js_attributes')]/t[@t-foreach='attributes']" position="before">
			<t t-call="website_stock_availability_filter.avalible_in_stock"/>
		</xpath>
	</template>

	<!-- En 16 se mostraba también fuera del formulario cuando no había atributos;
	     en 19 el contenedor estándar solo existe si hay atributos o etiquetas. -->
	<template id="avalible_in_stock_no_attributes" name="Availability Filter (sin atributos)"
			  inherit_id="website_sale.products_attributes" priority="9">
		<xpath expr="//div[@id='wsale_products_attributes_collapse']" position="attributes">
			<attribute name="t-if">True</attribute>
		</xpath>
	</template>

	<template id="product_items_label" customize_show="True" active="False"
			  inherit_id="website_sale.products_item" name="Show Available Label">
		<xpath expr="//div[contains(@t-attf-class, 'oe_product_image position-relative')]" position="inside">
			<t t-if="product.sudo().qty_available > 0">
				<div class="biz_ribbon-wrapper">
					<span id="style_3" class="style_3 label_div d-inline-block p-1" style="background-color: #08B43C;">
						<span class="ribbon_label_name px-1">Available</span>
					</span>
				</div>
			</t>
		</xpath>
	</template>

	<template id="product_page_stock_label" customize_show="True" active="False"
			  inherit_id="website_sale.product_title" name="Product Page Available Label">
		<xpath expr="//h1" position="before">
			<t t-if="product.sudo().qty_available > 0">
				<div class="biz_prod_label p-0">
					<span class="biz_label_tag d-inline-block p-1" style="background-color: #08B43C;">
						<span class="ribbon_label_name px-1">Available</span>
					</span>
				</div>
			</t>
		</xpath>
	</template>
</odoo>
