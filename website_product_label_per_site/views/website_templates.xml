<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dibuja una label. Variables: wlabel (website.product.label), wlabel_title -->
    <template id="website_label_badge" name="Website Product Label (por sitio)">
        <div t-if="wlabel" t-att-class="wlabel.position">
            <span>
                <img class="img img-responsive" role="img"
                     t-att-src="website.image_url(wlabel, 'image')"
                     t-att-title="wlabel.name"
                     t-att-style="wlabel.get_wpl_image_style()"/>
                <span t-if="wlabel.label_type == 'custom'" class="label_font"
                      t-esc="wlabel_title"
                      t-att-style="wlabel.get_wpl_font_style()"/>
            </span>
        </div>
    </template>

    <!-- Grilla de la tienda: reemplaza el bloque de BrowseInfo -->
    <template id="products_item_label_per_site"
              inherit_id="odoo_website_product_label.product_listing_page_extended"
              name="Product label per website (shop)">
        <xpath expr="//t[@t-if='product.select_label']" position="replace">
            <t t-set="wlabel_data" t-value="product.get_website_label_data(website)"/>
            <t t-set="wlabel" t-value="wlabel_data[0]"/>
            <t t-set="wlabel_title" t-value="wlabel_data[1]"/>
            <t t-call="website_product_label_per_site.website_label_badge"/>
        </xpath>
    </template>

    <!-- Página de producto: reemplaza el bloque de BrowseInfo -->
    <template id="product_page_label_per_site"
              inherit_id="odoo_website_product_label.single_product_page_extended"
              name="Product label per website (product page)">
        <xpath expr="//t[@t-if='product.select_label']" position="replace">
            <t t-set="wlabel_data" t-value="product.get_website_label_data(website)"/>
            <t t-set="wlabel" t-value="wlabel_data[0]"/>
            <t t-set="wlabel_title" t-value="wlabel_data[1]"/>
            <t t-call="website_product_label_per_site.website_label_badge"/>
        </xpath>
    </template>

</odoo>
