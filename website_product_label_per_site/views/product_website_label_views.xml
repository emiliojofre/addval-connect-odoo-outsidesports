<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tabla "Labels por sitio web" en la ficha del producto -->
    <record id="product_template_form_website_labels" model="ir.ui.view">
        <field name="name">product.template.form.website.labels</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="odoo_website_product_label.odoo_product_template_inherit_bi_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='Website Product Label']" position="after">
                <group string="Labels por sitio web" name="website_labels">
                    <div class="text-muted" colspan="2">
                        Si un sitio no aparece aquí, se muestra la label general de arriba.
                        Una línea con la label vacía oculta la label en ese sitio.
                    </div>
                    <field name="website_label_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                            <field name="website_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="label_id" options="{'no_create': True}"/>
                            <field name="lbl_title" optional="hide"/>
                        </tree>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Listado global, útil para editar o importar en masa -->
    <record id="product_website_label_tree" model="ir.ui.view">
        <field name="name">product.website.label.tree</field>
        <field name="model">product.website.label</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="product_tmpl_id"/>
                <field name="website_id" options="{'no_create': True}"/>
                <field name="label_id" options="{'no_create': True}"/>
                <field name="lbl_title" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="product_website_label_search" model="ir.ui.view">
        <field name="name">product.website.label.search</field>
        <field name="model">product.website.label</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id"/>
                <field name="label_id"/>
                <field name="website_id"/>
                <filter name="no_label" string="Sin label (oculta)" domain="[('label_id', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_website" string="Sitio web" context="{'group_by': 'website_id'}"/>
                    <filter name="group_label" string="Label" context="{'group_by': 'label_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_product_website_label" model="ir.actions.act_window">
        <field name="name">Labels por sitio web</field>
        <field name="res_model">product.website.label</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_group_website': 1}</field>
    </record>

    <menuitem id="menu_product_website_label"
              name="Labels por sitio web"
              parent="sale.product_menu_catalog"
              action="action_product_website_label"
              groups="sales_team.group_sale_manager"
              sequence="99"/>

</odoo>
