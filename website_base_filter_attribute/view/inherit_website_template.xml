<!--
    Port a Odoo 19 (Outside Sports):
    En 19 el formulario de filtros (js_attributes) y la lista de atributos son
    estándar (website_sale.product_attribute_filters_form) y sirven tanto para
    escritorio como para el panel móvil. Solo se mantiene el contenedor
    wk_product_custom_filters, donde otros módulos (marcas) insertan sus filtros.
-->
<odoo>
    <data>

        <template id="inherit_website_products" priority="13"
                  inherit_id="website_sale.product_attribute_filters_form"
                  name="Base Products Form">
            <xpath expr="//form[contains(@t-attf-class, 'js_attributes')]" position="inside">
                <div class="wk_product_custom_filters"/>
            </xpath>
        </template>

    </data>
</odoo>
